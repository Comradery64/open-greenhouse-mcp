# Required for Harvest: v3 client credentials, issued by a Greenhouse admin under
# Configure → Dev Center → API Credential Management, with scopes granted per
# endpoint. Harvest v1/v2 (and the GREENHOUSE_API_KEY below) stopped working after
# 2026-08-31 — see docs/harvest-v3-migration.md.
GREENHOUSE_CLIENT_ID=your-harvest-client-id
GREENHOUSE_CLIENT_SECRET=your-harvest-client-secret

# Optional: the public Job Board API, a separate product still on v1.
# GREENHOUSE_BOARD_TOKEN=your-board-url-slug

# Optional: the Ingestion API, also still on v1. Not used by Harvest.
# GREENHOUSE_API_KEY=your-legacy-v1-key

# Optional: your Greenhouse user ID. Used for two things at once —
#   1. Harvest v3 attributes each API call to this user (the OAuth `sub` claim).
#   2. User-scoped permissions, deriving the tool profile from their role.
# When set, the server fetches the user's permissions at startup and:
#   - site_admin=true → full profile (all tools, all jobs)
#   - has job permissions → recruiter profile (writes scoped to permitted jobs only)
#   - no permissions → read-only profile
#   - disabled user → server refuses to start
# Also automatically sets On-Behalf-Of header for audit trail.
# GREENHOUSE_USER_ID=your-greenhouse-user-id

# Optional: included in On-Behalf-Of header on all write operations (audit trail)
# Ignored when GREENHOUSE_USER_ID is set (On-Behalf-Of is derived automatically).
# GREENHOUSE_ON_BEHALF_OF=your-greenhouse-user-id

# Optional: register Harvest tools that have not yet been checked against the
# Harvest v3 guides. Off by default — unmigrated tools are withheld so a caller
# gets "no such tool" rather than a plausible-looking wrong answer.
# GREENHOUSE_ALLOW_UNMIGRATED_TOOLS=1

# Optional: turn a projection/payload field mismatch into a hard error instead of
# a warning. Used by CI; leave unset in production.
# GREENHOUSE_STRICT_PROJECTION=1

# Optional: tool profile — full (default), recruiter, or read-only
# Ignored when GREENHOUSE_USER_ID is set (profile is derived automatically).
# GREENHOUSE_TOOL_PROFILE=recruiter

# Optional: shorthand for GREENHOUSE_TOOL_PROFILE=read-only
# GREENHOUSE_READ_ONLY=true

# Optional: structured JSON logging (debug, info, warning, error)
# GREENHOUSE_LOG_LEVEL=info
# GREENHOUSE_LOG_FILE=/var/log/greenhouse-mcp.log

# Optional: webhook receiver settings
# GREENHOUSE_WEBHOOK_SECRET=your-webhook-secret-key
# WEBHOOK_DB_PATH=~/.open-greenhouse-mcp/webhooks.db
# PORT=8080
